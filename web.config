<configuration>
  <system.webServer>

    <handlers>
      <add name="httpPlatformHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified" />
    </handlers>

    <httpPlatform
      processPath="node"
      arguments=".\dist\server.js"
      startupTimeLimit="20"
      startupRetryCount="3"
      stdoutLogEnabled="true"
      stdoutLogFile=".\logs\node">

      <environmentVariables>

        <environmentVariable
          name="PORT"
          value="%HTTP_PLATFORM_PORT%" />

        <environmentVariable
          name="NODE_ENV"
          value="production" />

        <environmentVariable
          name="GEMINI_API_KEY"
          value="" />

      </environmentVariables>

    </httpPlatform>

  </system.webServer>
</configuration>